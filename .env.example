APP_NAME="Московский паломник"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=palomnik
DB_USERNAME=root
DB_PASSWORD=

# Резервные копии. BACKUP_PATH рекомендуется указывать абсолютным путём
# вне public_html и, по возможности, на отдельном диске/томе.
BACKUP_ENABLED=true
BACKUP_PATH=
BACKUP_SCHEDULE_TIME=01:30
BACKUP_KEEP_LAST=14
BACKUP_MAX_AGE_DAYS=30
BACKUP_MAX_RUNTIME_SECONDS=3600
BACKUP_MIN_FREE_SPACE_MB=2048
BACKUP_DATABASE_ENABLED=true
BACKUP_PUBLIC_FILES_ENABLED=true
MYSQLDUMP_BINARY=mysqldump
MYSQL_BINARY=mysql
TAR_BINARY=tar
# Дополнительные параметры через запятую, например: --no-tablespaces
MYSQLDUMP_ADDITIONAL_OPTIONS=

# Журнал безопасных развёртываний и максимально допустимый возраст
# преддеплойной резервной копии.
DEPLOYMENTS_PATH=
DEPLOY_BACKUP_MAX_AGE_MINUTES=60

ADMIN_NAME="Главный администратор"
ADMIN_EMAIL=admin@palomnik.local
ADMIN_PASSWORD=

# Создание полного набора демонстрационных данных при php artisan db:seed.
DEMO_DATA_ENABLED=false

# Автоматическое пропорциональное уменьшение всех загружаемых изображений.
# Маленькие изображения не увеличиваются. Значения задают максимальный прямоугольник.
IMAGE_RESIZE_ENABLED=true
IMAGE_MAX_WIDTH=1920
IMAGE_MAX_HEIGHT=1080
IMAGE_JPEG_QUALITY=85
IMAGE_WEBP_QUALITY=85
IMAGE_PNG_COMPRESSION=8

# Серверный кэш сторонних CSS, JavaScript и шрифтов.
# Браузер получает файлы только с домена приложения по адресу /assets/vendor/...
FRONTEND_ASSETS_DISK=local
FRONTEND_ASSETS_DIRECTORY=frontend-assets
FRONTEND_ASSETS_TIMEOUT=45

# MapLibre / OpenStreetMap / OpenMapTiles
# Внешний style.json имеет приоритет. Если он пуст, Laravel отдаёт /api/v1/map/style.json.
MAP_STYLE_URL=
# Пример собственного TileServer GL: http://127.0.0.1:8080/data/v3/{z}/{x}/{y}.pbf
OPENMAPTILES_TILE_URL=
# Пример: http://127.0.0.1:8080/fonts/{fontstack}/{range}.pbf
MAP_GLYPHS_URL=

# Источник растровых тайлов.
MAP_RASTER_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Режим загрузки тайлов:
# cache  — браузер обращается к вашему серверу, тайлы сохраняются в storage;
# direct — браузер загружает тайлы напрямую с MAP_RASTER_TILE_URL, серверный кэш не используется.
MAP_TILE_MODE=cache

# Следующие настройки используются только при MAP_TILE_MODE=cache.
MAP_TILE_CACHE_DISK=local
MAP_TILE_CACHE_DIRECTORY=map-tiles/osm
# Максимальный размер серверного кэша в МБ. 1024 = 1 ГБ, 0 = без ограничения.
# При достижении лимита тайл будет показан пользователю, но не сохранится на диск.
MAP_TILE_CACHE_MAX_SIZE_MB=1024
# Используется, если источник не передал Cache-Control или Expires. Минимум 7 суток.
MAP_TILE_DEFAULT_TTL=604800
# Браузер хранит локальный адрес тайла 1 сутки.
MAP_TILE_BROWSER_TTL=86400
MAP_TILE_CONNECT_TIMEOUT=5
MAP_TILE_TIMEOUT=15
MAP_TILE_MAX_ZOOM=19
# В production укажите реальный адрес сайта и контакт, например:
# MAP_TILE_USER_AGENT="MoscowPilgrim/1.0 (+https://palomnik.example; admin@palomnik.example)"
MAP_TILE_USER_AGENT=

# Динамическая загрузка объектов только по видимой области карты.
# Кэш уменьшает число одинаковых SQL-запросов при небольших перемещениях карты.
MAP_VIEWPORT_CACHE_TTL=90
MAP_DETAIL_CACHE_TTL=300
# Максимум серверных кластеров на малом масштабе.
MAP_VIEWPORT_CLUSTER_LIMIT=600
# Максимум отдельных объектов и точек интереса в одной видимой области.
MAP_VIEWPORT_OBJECT_LIMIT=2500
MAP_VIEWPORT_POI_LIMIT=1000

# Необязательные лицензированные слои.
MAP_SATELLITE_TILE_URL=
MAP_HISTORIC_TILE_URL=
MAP_ATTRIBUTION="© OpenStreetMap contributors"
# Включайте только при собственном/лицензированном сервере тайлов.
MAP_OFFLINE_ENABLED=false
MAP_OFFLINE_TILE_LIMIT=100000
# Для production рекомендуется собственный Valhalla.
VALHALLA_URL=https://valhalla.openstreetmap.de
VALHALLA_TIMEOUT=20

PRIVACY_POLICY_VERSION=1.0

# VK ID OAuth 2.1. Callback must exactly match the address configured in VK ID.
VKID_CLIENT_ID=
VKID_CLIENT_SECRET=
VKID_REDIRECT_URI="${APP_URL}/auth/vk/callback"
VKID_SCOPES=email
VKID_PKCE_TTL=10
VKID_CACHE_STORE=file
VKID_CACHE_PREFIX=socialite:vkid:pkce:
VKID_API_VERSION=5.199

FIREBASE_PUSH_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=storage/app/firebase/service-account.json

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
